<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@id/exo_bottom_bar"
    android:layout_width="match_parent"
    android:layout_height="@dimen/yummy_player_bottom_bar_height"
    android:layout_gravity="bottom"
    android:background="@drawable/player_bottom_control_scrim"
    android:gravity="top"
    android:layoutDirection="ltr"
    android:orientation="vertical"
    android:paddingStart="0dp"
    android:paddingTop="0dp"
    android:paddingEnd="0dp"
    android:paddingBottom="6dp">

    <me.yummydroid.app.ui.YummyPlayerTimeBar
        android:id="@id/exo_progress"
        style="@style/ExoStyledControls.TimeBar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/yummy_player_progress_height"
        app:ad_marker_width="3dp"
        app:bar_height="4dp"
        app:touch_target_height="@dimen/yummy_player_progress_height" />

    <HorizontalScrollView
        android:id="@+id/yummy_player_bottom_scroll"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="6dp"
        android:fillViewport="true"
        android:focusable="false"
        android:scrollbars="none">
        <LinearLayout
            android:id="@+id/yummy_player_bottom_content"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:baselineAligned="false"
            android:gravity="center_vertical"
            android:layoutDirection="ltr"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingEnd="12dp">

            <LinearLayout
                android:id="@+id/yummy_player_bottom_start"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_gravity="center_vertical|start"
                android:baselineAligned="false"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="0dp"
                android:paddingEnd="14dp">

                <LinearLayout
                    android:id="@id/exo_time"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:importantForAccessibility="noHideDescendants"
                    android:layoutDirection="ltr"
                    android:paddingStart="0dp"
                    android:paddingEnd="10dp">

                    <TextView
                        android:id="@id/exo_position"
                        style="@style/ExoStyledControls.TimeText.Position" />

                    <TextView style="@style/ExoStyledControls.TimeText.Separator" />

                    <TextView
                        android:id="@id/exo_duration"
                        style="@style/ExoStyledControls.TimeText.Duration" />
                </LinearLayout>

                <TextView
                    android:id="@+id/yummy_player_info"
                    android:layout_width="wrap_content"
                    android:maxWidth="72dp"
                    android:layout_height="match_parent"
                    android:ellipsize="end"
                    android:gravity="center_vertical"
                    android:maxLines="1"
                    android:textColor="#CCFFFFFF"
                    android:textSize="13sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@id/exo_basic_controls"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:orientation="horizontal"
                android:visibility="gone">

                <ImageButton
                    android:id="@id/exo_settings"
                    style="@style/ExoStyledControls.Button.Bottom.Settings"
                    android:contentDescription="@null"
                    android:importantForAccessibility="no" />
            </LinearLayout>

            <Space
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/yummy_player_quality"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginEnd="4dp"
                android:background="@drawable/player_center_control_background"
                android:clickable="true"
                android:contentDescription="@string/player_quality"
                android:focusable="true"
                android:gravity="center"
                android:includeFontPadding="false"
                android:minWidth="0dp"
                android:paddingStart="0dp"
                android:paddingEnd="0dp"
                android:text="@string/player_quality"
                android:textColor="@color/player_control_content"
                android:textSize="12sp"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/yummy_player_source"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginEnd="4dp"
                android:background="@drawable/player_center_control_background"
                android:clickable="true"
                android:contentDescription="@string/player_source"
                android:focusable="true"
                android:minWidth="0dp"
                android:padding="14dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_player_source"
                app:tint="@color/player_control_content" />

            <ImageButton
                android:id="@+id/yummy_player_voice"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginEnd="4dp"
                android:background="@drawable/player_center_control_background"
                android:clickable="true"
                android:contentDescription="@string/player_voice"
                android:focusable="true"
                android:minWidth="0dp"
                android:padding="14dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_player_voice"
                app:tint="@color/player_control_content" />

            <ImageButton
                android:id="@+id/yummy_player_subtitles"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginEnd="4dp"
                android:background="@drawable/player_center_control_background"
                android:clickable="true"
                android:contentDescription="@string/player_subtitles"
                android:focusable="true"
                android:minWidth="0dp"
                android:padding="14dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_player_subtitles"
                app:tint="@color/player_control_content" />

            <ImageButton
                android:id="@+id/yummy_player_subscription"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginEnd="4dp"
                android:background="@drawable/player_center_control_background"
                android:clickable="true"
                android:contentDescription="@string/player_subscription"
                android:focusable="true"
                android:minWidth="0dp"
                android:padding="14dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_player_subscription"
                app:tint="@color/player_control_content" />

            <ImageButton
                android:id="@+id/yummy_player_speed"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginEnd="4dp"
                android:background="@drawable/player_center_control_background"
                android:clickable="true"
                android:contentDescription="@string/player_speed"
                android:focusable="true"
                android:minWidth="0dp"
                android:padding="14dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_player_speed"
                app:tint="@color/player_control_content" />

            <me.yummydroid.app.ui.YummyCastRouteButton
                android:id="@+id/yummy_player_cast"
                android:theme="@style/ThemeOverlay.YummyDroid.MediaRouteButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginEnd="4dp"
                android:background="@drawable/player_center_control_background"
                android:clickable="true"
                android:contentDescription="@string/player_cast"
                android:focusable="true"
                android:minWidth="0dp"
                android:padding="14dp"
                android:visibility="gone" />

            <ImageButton
                android:id="@+id/yummy_player_pip"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/player_center_control_background"
                android:clickable="true"
                android:contentDescription="@string/player_pip"
                android:focusable="true"
                android:minWidth="0dp"
                android:padding="14dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_player_pip"
                app:tint="@color/player_control_content" />
        </LinearLayout>
    </HorizontalScrollView>
</LinearLayout>
