<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <View
        android:id="@id/exo_controls_background"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="#99000000" />

    <me.yummydroid.app.ui.PlayerControlsViewport
        android:id="@+id/yummy_player_controls_viewport"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center"
        android:layoutDirection="ltr">

        <LinearLayout
            android:id="@+id/yummy_player_top_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/yummy_player_top_bar_height"
            android:layout_gravity="top"
            android:background="@drawable/player_top_control_scrim"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="10dp"
            android:paddingEnd="14dp">

            <ImageButton
                android:id="@+id/yummy_player_back"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/player_center_control_background"
                android:clickable="true"
                android:contentDescription="@string/player_back"
                android:focusable="true"
                android:padding="14dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_player_back" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/yummy_player_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:includeFontPadding="false"
                    android:maxLines="2"
                    android:lineSpacingExtra="0dp"
                    android:lineSpacingMultiplier="1"
                    android:textColor="@color/player_control_content"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/yummy_player_subtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:includeFontPadding="false"
                    android:maxLines="2"
                    android:textColor="#CCFFFFFF"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <FrameLayout
            android:id="@+id/yummy_player_episode_controls"
            android:layout_width="192dp"
            android:layout_height="64dp"
            android:layout_gravity="center"
            android:clipChildren="false"
            android:clipToPadding="false">

            <ImageButton
                android:id="@+id/yummy_episode_previous"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_gravity="center"
                android:background="@drawable/player_center_control_background"
                android:clickable="true"
                android:contentDescription="@string/player_previous"
                android:focusable="true"
                android:padding="14dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_episode_previous"
                android:translationX="-72dp" />

            <FrameLayout
                android:id="@+id/yummy_play_pause_container"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:layout_gravity="center">

                <ImageButton
                    android:id="@id/exo_play_pause"
                    style="@style/ExoStyledControls.Button.Center.PlayPause"
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:layout_gravity="center"
                    android:background="@drawable/player_center_control_background"
                    android:contentDescription="@string/player_play_pause" />
            </FrameLayout>

            <ImageButton
                android:id="@+id/yummy_episode_next"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_gravity="center"
                android:background="@drawable/player_center_control_background"
                android:clickable="true"
                android:contentDescription="@string/player_next"
                android:focusable="true"
                android:padding="14dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_episode_next"
                android:translationX="72dp" />
        </FrameLayout>

        <me.yummydroid.app.ui.PlayerSkipControlsLayout
            android:id="@+id/yummy_skip_controls"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_marginEnd="14dp"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">

            <TextView
                android:id="@+id/yummy_skip_skip"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/player_skip_control_background"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:minWidth="132dp"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:textColor="@color/player_control_content"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/yummy_skip_watch"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:background="@drawable/player_skip_control_background"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:minWidth="96dp"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:text="@string/player_watch"
                android:textColor="@color/player_control_content"
                android:textSize="14sp"
                android:textStyle="bold" />
        </me.yummydroid.app.ui.PlayerSkipControlsLayout>

        <include layout="@layout/yummy_player_bottom_controls" />

    </me.yummydroid.app.ui.PlayerControlsViewport>

</merge>
