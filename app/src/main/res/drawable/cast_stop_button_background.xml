<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <corners android:radius="8dp" />
            <solid android:color="#33516A8A" />
            <stroke android:width="1dp" android:color="#FFFFB454" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <corners android:radius="8dp" />
            <solid android:color="#33516A8A" />
            <stroke android:width="2dp" android:color="#FFFFB454" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="8dp" />
            <solid android:color="#22101A2C" />
            <stroke android:width="1dp" android:color="#66516A8A" />
        </shape>
    </item>
</selector>
